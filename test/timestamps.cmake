file(MAKE_DIRECTORY "${TEST_DIR}")

function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${ARGV}: ${result}\n${output}\n${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
endfunction()

# DOS date/time: 2024-06-15 12:34:56, zero date, invalid calendar/time fields.
foreach(case valid valid_midnight valid_leap missing missing_zero month day february leap_century hour minute second)
    set(date 0x58cf)
    set(time 0x645c)
    set(expected missing)
    set(timestamp 0)
    if(case STREQUAL "valid")
        set(expected "2024-06-15 12:34:56")
        set(timestamp 1718454896)
    elseif(case STREQUAL "valid_midnight")
        set(time 0)
        set(expected "2024-06-15 00:00:00")
        set(timestamp 1718409600)
    elseif(case STREQUAL "valid_leap")
        set(date 0x585d)
        set(expected "2024-02-29 12:34:56")
        set(timestamp 1709210096)
    elseif(case STREQUAL "missing")
        set(date 0)
    elseif(case STREQUAL "month")
        set(date 0x59af)
    elseif(case STREQUAL "day")
        set(date 0x58c0)
    elseif(case STREQUAL "february")
        set(date 0x585e)
    elseif(case STREQUAL "leap_century")
        set(date 0xf05d) # 2100-02-29 is not a leap day.
    elseif(case STREQUAL "hour")
        set(time 0xc45c)
    elseif(case STREQUAL "minute")
        set(time 0x679c)
    elseif(case STREQUAL "second")
        set(time 0x645e)
    else()
        set(date 0)
        set(time 0)
    endif()
    run("${PROBE}" prepare "${date}" "${time}" "${expected}" "${timestamp}")
    run("${UNSHIELD}" -t -d "${case}" x data1.cab)
    if(NOT expected STREQUAL "missing")
        run("${PROBE}" check "${case}/group/files/test.txt" "${timestamp}")
        run("${UNSHIELD}" -d default x data1.cab)
        run("${PROBE}" check default/group/files/test.txt current)
    else()
        run("${PROBE}" check "${case}/group/files/test.txt" current)
    endif()
endforeach()

# Listing must not invent a date for invalid metadata.
run("${UNSHIELD}" l data1.cab)
if(NOT output MATCHES "-------------------")
    message(FATAL_ERROR "Missing date not marked in listing: ${output}")
endif()

# Fail before constructing the file path; diagnostics still need the file name.
string(REPEAT x 8192 long_directory)
execute_process(COMMAND "${UNSHIELD}" -d "${long_directory}" x data1.cab
    WORKING_DIRECTORY "${TEST_DIR}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "1" OR NOT error MATCHES "Failed to extract file 'test.txt'")
    message(FATAL_ERROR "Early extraction failure: ${result}\n${error}")
endif()
